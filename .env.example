# --- الزامی ---
BOT_TOKEN=123456:ABC...            # توکن از BotFather (هرگز در گیت قرار نده)
OWNER_ID=123456789                 # شناسه عددی مالک (برای پنل مدیریت)
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# --- اختیاری ---
MODE=webhook                       # webhook (رندر/سرور) یا polling (اجرای محلی)
BASE_URL=https://your-app.onrender.com   # روی رندر خودکار از RENDER_EXTERNAL_URL خوانده می‌شود
WEBHOOK_SECRET=                    # خالی = از توکن ساخته می‌شود
ALLOW_NAMES=false                  # فعال‌کردن دسته «اسامی خاص»
BUTTON_STYLES=true                 # رنگ دکمه‌ها (style)
LOG_LEVEL=INFO
